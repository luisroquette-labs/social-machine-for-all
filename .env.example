# Required: your own Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required for cron and webhook authentication. Generate distinct random values.
CRON_SECRET=
TELEGRAM_WEBHOOK_SECRET=

# Application URL used by callbacks and generated assets
APP_BASE_URL=http://localhost:3000

# Optional target for manually enabled, workspace-specific cron routes.
# Leave empty until onboarding is complete. Never copy an ID from another installation.
WORKSPACE_ID=
# Optional second workspace for shared heartbeat and Instagram digest monitoring.
SECONDARY_WORKSPACE_ID=

# Paid AI routes require this project key. Configure OpenAI/Anthropic as BYOK in OpenRouter.
OPENROUTER_API_KEY=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
REEL_RENDERER_URL=
REEL_RENDERER_API_KEY=
RESEND_API_KEY=
NOTIFICATION_EMAIL=
RESEND_FROM_EMAIL=

# Optional brand assets and webhook forwarding. Leave empty by default.
BRAND_LOGO_URL=
INSTAGRAM_FALLBACK_WEBHOOK_URL=
